# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Clé API Simli (10 $ de crédits gratuits à l'inscription sur app.simli.com)
Simli="MY_SIMLI_API_KEY"
SIMLI_API_KEY="MY_SIMLI_API_KEY"

# Clé API Decart AI (nommée Live ou DECART_API_KEY dans le panneau Secrets)
Live="MY_DECART_API_KEY"
LIVE="MY_DECART_API_KEY"
DECART_API_KEY="MY_DECART_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
